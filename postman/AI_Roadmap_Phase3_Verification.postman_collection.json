      "item": [
        {
          "name": "GET /api/profiles (baseline)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Has active_profile_id', () => pm.expect(data).to.have.property('active_profile_id'));",
                  "pm.test('Has profiles array', () => pm.expect(data.profiles).to.be.an('array'));",
                  "pm.test('At least one profile exists', () => pm.expect(data.profiles.length).to.be.at.least(1));",
                  "pm.collectionVariables.set('baselineProfileCount', data.profiles.length);",
                  "pm.collectionVariables.set('originalActiveProfileId', data.active_profile_id);",
                  "console.log('Baseline: ' + data.profiles.length + ' profile(s), active=' + data.active_profile_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profiles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profiles"]
            }
          }
        },
        {
          "name": "GET /api/profile (active)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
