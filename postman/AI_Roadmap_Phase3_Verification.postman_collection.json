                  "const data = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(data).to.have.property('id'));",
                  "pm.test('Has roadmap_variant', () => pm.expect(data).to.have.property('roadmap_variant'));",
                  "pm.test('id matches active_profile_id', () => pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('originalActiveProfileId'))));",
                  "pm.collectionVariables.set('baselineLeetcodeTarget', data.leetcode_target);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            }
